diff --git a/impacket/ImpactPacket.py b/impacket/ImpactPacket.py
index a715c2d4..76177d0d 100644
--- a/impacket/ImpactPacket.py
+++ b/impacket/ImpactPacket.py
@@ -1531,7 +1531,15 @@ class TCP(Header):
 
     def load_header(self, aBuffer):
         self.set_bytes_from_string(aBuffer[:20])
-        opt_left = (self.get_th_off() - 5) * 4
+        th_off = self.get_th_off()
+        if not (5 <= th_off <= 15):
+            raise ImpactPacketException('Wrong TCP DataOffset. Expected between 5 and 15, got %d' % th_off)
+        if self.get_th_reserved() != 0:
+            raise ImpactPacketException('Wrong TCP Reserved field. Expected 0, got %d' % self.get_th_reserved())
+        if len(aBuffer) < th_off * 4:
+            raise ImpactPacketException('Truncated TCP packet. Expected at least %d bytes, got %d' % (th_off * 4, len(aBuffer)))
+
+        opt_left = (th_off - 5) * 4
         opt_bytes = array.array('B', aBuffer[20:(20 + opt_left)])
         if len(opt_bytes) != opt_left:
             raise ImpactPacketException("Cannot load options from truncated packet")
