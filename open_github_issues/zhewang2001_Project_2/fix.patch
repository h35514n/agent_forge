diff --git a/.github/workflows/checkstyle.yml b/.github/workflows/checkstyle.yml
new file mode 100644
index 0000000..7e018c5
--- /dev/null
+++ b/.github/workflows/checkstyle.yml
@@ -0,0 +1,37 @@
+name: Checkstyle
+
+on:
+  push:
+    branches:
+      - main
+  pull_request:
+    branches:
+      - main
+
+jobs:
+  checkstyle:
+    runs-on: ubuntu-latest
+
+    steps:
+    - name: Checkout code
+      uses: actions/checkout@v4
+
+    - name: Set up JDK 17
+      uses: actions/setup-java@v4
+      with:
+        java-version: '17'
+        distribution: 'temurin'
+        cache: 'gradle'
+
+    - name: Grant execute permission for gradlew
+      run: chmod +x gradlew
+
+    - name: Run Checkstyle
+      run: ./gradlew checkstyleMain checkstyleTest
+
+    - name: Upload Checkstyle Report
+      uses: actions/upload-artifact@v4
+      with:
+        name: checkstyle-report
+        path: app/build/reports/checkstyle/
+        retention-days: 5
diff --git a/app/build.gradle b/app/build.gradle
index a1f04f1..14c410d 100644
--- a/app/build.gradle
+++ b/app/build.gradle
@@ -1,5 +1,6 @@
 plugins {
     id 'com.android.application'
+    id 'checkstyle'
 }
 
 android {
@@ -43,3 +44,50 @@ dependencies {
     androidTestImplementation 'androidx.test.ext:junit:1.3.0'
     androidTestImplementation 'androidx.test.espresso:espresso-core:3.7.0'
 }
+
+checkstyle {
+    toolVersion = '10.12.4' // Use a recent stable version
+    configFile = file("${rootDir}/app/config/checkstyle/checkstyle.xml")
+    // Set the severity to warning so that it doesn't fail the build by default
+    // This can be overridden in CI/CD to fail on violations
+    ignoreFailures = false
+}
+
+tasks.withType(Checkstyle) {
+    // Exclude generated files
+    exclude '**/R.java'
+    exclude '**/BuildConfig.java'
+    exclude '**/gen/**'
+    exclude '**/generated/**'
+    exclude '**/BR.java' // Data binding generated file
+    exclude '**/Manifest.java' // AndroidManifest generated file
+
+    // Report format
+    reports {
+        xml.required = true
+        html.required = true
+    }
+}
+
+
+
+afterEvaluate {
+    task checkstyleMain(type: Checkstyle) {
+        group = 'verification'
+        description = 'Runs Checkstyle on the main app sources.'
+        source 'src/main/java'
+        classpath = files() // Required for Checkstyle task
+    }
+
+    task checkstyleTest(type: Checkstyle) {
+        group = 'verification'
+        description = 'Runs Checkstyle on the test app sources.'
+        source 'src/test/java'
+        classpath = files() // Required for Checkstyle task
+    }
+
+    // Make the check task depend on our custom checkstyle tasks
+    tasks.named('check') {
+        dependsOn checkstyleMain, checkstyleTest
+    }
+}
diff --git a/app/config/checkstyle/checkstyle.xml b/app/config/checkstyle/checkstyle.xml
new file mode 100644
index 0000000..d2691dc
--- /dev/null
+++ b/app/config/checkstyle/checkstyle.xml
@@ -0,0 +1,95 @@
+<?xml version="1.0"?>
+<!DOCTYPE module PUBLIC
+    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
+    "https://checkstyle.org/dtds/configuration_1_3.dtd">
+
+<module name="Checker">
+    <!--
+        If you set the basedir property below, then all reported file
+        names will be relative to the given directory. See
+        https://checkstyle.org/config.html#Checker
+        <property name="basedir" value="${project.basedir}"/>
+    -->
+    <property name="severity" value="warning"/>
+
+    <property name="fileExtensions" value="java, xml"/>
+
+    <!-- Excludes all 'module-info.java' files.                  -->
+    <!-- See https://checkstyle.org/config.html#Checker -->
+    <module name="BeforeExecutionExclusionFileFilter">
+        <property name="fileNamePattern" value="module\-info\.java$"/>
+    </module>
+    <!-- https://checkstyle.org/config_filters.html#SuppressionFilter -->
+    <module name="SuppressionFilter">
+        <property name="file" value="${org.checkstyle.sun.suppressionfilter.config}"
+                  default="checkstyle-suppressions.xml"/>
+        <property name="optional" value="true"/>
+    </module>
+
+    <!-- Checks for whitespace                               -->
+    <!-- See https://checkstyle.org/config_whitespace.html -->
+    <module name="FileTabCharacter"/>
+
+    <!-- Checks for Size Violations.                   -->
+    <!-- See https://checkstyle.org/config_sizes.html -->
+    <module name="FileLength"/>
+    <module name="LineLength">
+        <property name="max" value="120"/>
+        <property name="ignorePattern" value="^package.*|^import.*|a href|href|url|https?://|ftp://"/>
+    </module>
+
+    <module name="TreeWalker">
+        <!-- Checks for Naming Conventions.                  -->
+        <!-- See https://checkstyle.org/config_naming.html -->
+        <module name="MethodName"/>
+        <module name="LocalVariableName"/>
+        <module name="ParameterName"/>
+        <module name="TypeName"/>
+        <module name="ConstantName"/>
+        <module name="MemberName"/>
+
+        <!-- Checks for Imports.                           -->
+        <!-- See https://checkstyle.org/config_imports.html -->
+        <module name="AvoidStarImport"/>
+        <module name="UnusedImports"/>
+
+        <!-- Checks for Whitespace.                        -->
+        <!-- See https://checkstyle.org/config_whitespace.html -->
+        <module name="WhitespaceAfter"/>
+        <module name="WhitespaceAround"/>
+        <module name="NoWhitespaceBefore"/>
+
+        <!-- Checks for Braces.                            -->
+        <!-- See https://checkstyle.org/config_blocks.html -->
+        <module name="LeftCurly"/>
+        <module name="RightCurly"/>
+        <module name="NeedBraces"/>
+
+        <!-- Checks for Modifier Order.                    -->
+        <!-- See https://checkstyle.org/config_modifiers.html -->
+        <module name="ModifierOrder"/>
+
+        <!-- Checks for Common Bugs.                       -->
+        <!-- See https://checkstyle.org/config_misc.html -->
+        <module name="EmptyBlock"/>
+        <module name="EqualsHashCode"/>
+        <module name="InnerAssignment"/>
+        <module name="MissingSwitchDefault"/>
+        <module name="FallThrough"/>
+
+        <!-- Other checks -->
+        <module name="EmptyStatement"/>
+        <module name="MultipleVariableDeclarations"/>
+        <module name="ArrayTypeStyle"/>
+        <module name="UpperEll"/>
+        <module name="OneStatementPerLine"/>
+        <module name="OverloadMethodsDeclarationOrder"/>
+        <module name="PackageName"/>
+        <module name="RedundantImport"/>
+        <module name="SimplifyBooleanExpression"/>
+        <module name="SimplifyBooleanReturn"/>
+        <module name="StringLiteralEquality"/>
+        <module name="UnnecessaryParentheses"/>
+        <module name="VisibilityModifier"/>
+    </module>
+</module>
