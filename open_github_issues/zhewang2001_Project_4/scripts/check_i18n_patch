#!/usr/bin/env python3

"""check_i18n_patch

Verify that a patch correctly externalizes hardcoded
city-related strings by running Android lint and checking for HardcodedText
violations.

Usage:
    ./check_i18n_patch <repo_root>

Exits 0 if no HardcodedText violations are found, 1 otherwise.
"""

import subprocess
import sys
import xml.etree.ElementTree as ET
from pathlib import Path


def main() -> None:
    if len(sys.argv) < 2:
        print(f"Usage: {sys.argv[0]} <repo_root>", file=sys.stderr)
        sys.exit(1)

    root = Path(sys.argv[1])
    gradlew = root / "gradlew"
    lint_report = root / "app/build/reports/lint-results-debug.xml"

    print("\n==> Check 1: Android lint (HardcodedText)")

    if not gradlew.exists() or not gradlew.stat().st_mode & 0o111:
        print(f"  SKIP  gradlew not found or not executable at {gradlew}")
        sys.exit(1)

    result = subprocess.run(
        [str(gradlew), "-p", str(root), "lintDebug", "--quiet"],
        capture_output=True,
        text=True,
    )

    if not lint_report.exists():
        print("  FAIL  lint report not produced")
        print(result.stdout[-2000:] if result.stdout else "")
        print(result.stderr[-2000:] if result.stderr else "")
        sys.exit(1)

    failed = False

    tree = ET.parse(lint_report)
    issues = [i for i in tree.findall(".//issue") if i.get("id") == "HardcodedText"]

    if issues:
        print(f"  FAIL  {len(issues)} HardcodedText violation(s) found:")
        for issue in issues:
            loc = issue.find("location")
            if loc is not None:
                print(f"    {loc.get('file')}:{loc.get('line')}")
            message = issue.get("message", "")
            if message:
                print(f"      {message}")
        failed = True
    else:
        print("  PASS  No HardcodedText lint violations")

    if result.returncode != 0:
        print("  FAIL  Build errors detected (syntax or compilation):")
        print(result.stdout[-2000:] if result.stdout else "")
        print(result.stderr[-2000:] if result.stderr else "")
        failed = True

    sys.exit(1 if failed else 0)


if __name__ == "__main__":
    main()
